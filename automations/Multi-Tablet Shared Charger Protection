alias: "Multi-Tablet Shared Charger Protection"
description: "Turns shared tablet charger on below 30% and off when all tablets exceed 80%."
trigger:
  - platform: template
    value_template: >
      {% set batteries = [
        states('sensor.tablet_1_battery'),
        states('sensor.tablet_2_battery'),
        states('sensor.master_bedroom_onntablet_master_battery')
      ] %}
      {{ batteries | map('is_number') | list | min
         and (batteries | map('float') | list | min) < 30 }}
    id: need_charge

  - platform: template
    value_template: >
      {% set batteries = [
        states('sensor.tablet_1_battery'),
        states('sensor.tablet_2_battery'),
        states('sensor.master_bedroom_onntablet_master_battery')
      ] %}
      {{ batteries | map('is_number') | list | min
         and (batteries | map('float') | list | min) > 80 }}
    id: fully_charged

condition: []

action:
  - choose:
      - conditions:
          - condition: trigger
            id: need_charge
        sequence:
          - service: homeassistant.turn_on
            target:
              entity_id: switch.tablet_power_supply

      - conditions:
          - condition: trigger
            id: fully_charged
        sequence:
          - service: homeassistant.turn_off
            target:
              entity_id: switch.tablet_power_supply

mode: single
