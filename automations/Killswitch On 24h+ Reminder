alias: Killswitch On 24h+ Reminder
triggers:
  - entity_id: input_boolean.hvac_killswitch
    to: 'on'
    for:
      hours: 24
    trigger: state
actions:
  - repeat:
      while:
        - condition: state
          entity_id: input_boolean.hvac_killswitch
          state: 'on'
      sequence:
        - data:
            title: Climate Killswitch Still ON
            message: >-
              It's been on since {{
              as_timestamp(states.input_boolean.hvac_killswitch.last_changed) |
              timestamp_custom('%b %d, %I:%M %p') }}. Your thermostat/blinds
              automations are disabled.
          action: notify.notify
        - delay:
            hours: 24
